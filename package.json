{
  "name": "survey",
  "private": true,
  "type": "module",
  "scripts": {
    "questions": "bun scripts/questions.ts",
    "dev": "bun run questions && vite dev --port 3000",
    "build": "bun run questions && vite build",
    "test": "bun run questions && tsc --noEmit && bun test",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply survey --local",
    "db:migrate:remote": "wrangler d1 migrations apply survey --remote",
    "export": "bun run questions && bun scripts/export.ts"
  },
  "dependencies": {
    "@tanstack/charts": "1.2.0",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "daleui": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.142.0"
  }
}
